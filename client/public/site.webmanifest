{
	"$schema": "https://json.schemastore.org/web-manifest-combined.json",
	"name": "Gulchdale Commander Cube Draft",
	"short_name": "Gulchdale",
	"start_url": "/",
	"display": "standalone",
	"orientation": "landscape",
	"background_color": "#071014",
	"theme_color": "#17120b",
	"description": "Host or join a multiplayer draft of the Gulchdale Commander Cube.",
	"icons": [
		{
			"src": "/android-chrome-192x192.png?v=2",
			"sizes": "192x192",
			"type": "image/png"
		},
		{
			"src": "/android-chrome-512x512.png?v=2",
			"sizes": "512x512",
			"type": "image/png"
		}
	]
}
