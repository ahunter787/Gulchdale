# Plane overrides — SOURCED BY install.sh, not a Compose env file.
#
# install.sh downloads Plane's own `variables.env` for the pinned release and
# then applies exactly the keys listed in PLANE_OVERRIDE_KEYS below. Anything
# not listed keeps the value Plane shipped, so a new release's new settings
# keep working without this file having to track them.
#
# Deliberately a fragment of shell rather than a full copy of variables.env:
# a full copy would silently go stale on every Plane upgrade.

# Every key that install.sh writes into plane-app/variables.env.
PLANE_OVERRIDE_KEYS="
PLANE_COMPOSE_PROJECT
INSTALL_DIR
APP_PROTOCOL
IS_AIRGAPPED
DOMAIN_NAME
SITE_ADDRESS
SHARED_NETWORK
LISTEN_HTTP_PORT
LISTEN_HTTPS_PORT
LISTEN_SMTP_PORT_25
LISTEN_SMTP_PORT_465
LISTEN_SMTP_PORT_587
WEB_URL
CORS_ALLOWED_ORIGINS
WEBHOOK_ALLOWED_HOSTS
API_BASE_URL
CERT_EMAIL
CERT_ACME_DNS
DEBUG
OPENSEARCH_ENABLED
ENABLE_DRF_SPECTACULAR
USE_MINIO
USE_STORAGE_PROXY
MINIO_ENDPOINT_SSL
EMAIL_REPLICAS
IFRAMELY_REPLICAS
PI_API_REPLICAS
PI_BEAT_REPLICAS
PI_WORKER_REPLICAS
PI_AGENT_WORKER_REPLICAS
PI_MIGRATOR_REPLICAS
ARGUS_REPLICAS
ARGUS_MIGRATOR_REPLICAS
RUNNER_REPLICAS
API_KEY_RATE_LIMIT
ENABLE_SMTP
EMAIL_HOST
EMAIL_PORT
EMAIL_USE_TLS
EMAIL_USE_SSL
EMAIL_FROM
EMAIL_HOST_USER
EMAIL_HOST_PASSWORD
"

# --- Where data lives ------------------------------------------------------
# Relative to the vendored bundle directory, so all of Plane's data, logs, Caddy
# state and MinIO objects stay under .runtime/plane-app/plane/ on named bind
# mounts - and therefore inside this ecosystem's ignored runtime area, never in a
# stray /opt/plane.
INSTALL_DIR=./plane

# --- HTTP, no TLS ----------------------------------------------------------
# Local HTTP on the LAN. `APP_PROTOCOL=http` keeps Plane from redirecting to
# HTTPS and from asking ACME for a certificate it cannot get for an IP.
APP_PROTOCOL=http
IS_AIRGAPPED=0
DOMAIN_NAME="${ECOSYSTEM_HOST}"
# `:80` matches any Host header inside the container. A literal `localhost:80`
# would answer only for Host: localhost, which breaks access by LAN address.
SITE_ADDRESS=:80
CERT_EMAIL=admin@${PROJECT_SLUG}.local
CERT_ACME_DNS=

# --- Ports -----------------------------------------------------------------
# 80/443 belong to whatever web server fronts the application in production, so
# Plane is kept on the probed block instead. The SMTP ports are Plane's optional
# email intake, which stays disabled (EMAIL_REPLICAS=0) but keeps a
# non-conflicting mapping.
LISTEN_HTTP_PORT="${PLANE_HTTP_PORT}"
LISTEN_HTTPS_PORT="${PLANE_HTTPS_PORT}"
LISTEN_SMTP_PORT_25="${PLANE_SMTP_PORT_25}"
LISTEN_SMTP_PORT_465="${PLANE_SMTP_PORT_465}"
LISTEN_SMTP_PORT_587="${PLANE_SMTP_PORT_587}"

# --- Identity --------------------------------------------------------------
# The exact browser origin. All three of these must agree with what the user
# types, or sign-in redirects and link previews break.
WEB_URL="$(plane_url)"
CORS_ALLOWED_ORIGINS="$(plane_url)"
WEBHOOK_ALLOWED_HOSTS="$(plane_url)"
API_BASE_URL=http://api:8000
SHARED_NETWORK="${SHARED_NETWORK}"
# Named after this project so two projects never share container names.
PLANE_COMPOSE_PROJECT="${PLANE_COMPOSE_PROJECT}"

# --- Features deliberately off ---------------------------------------------
# No search index, no API schema page, no AI services, no telemetry-adjacent
# extras: this instance exists to track this project's work, not to run
# everything Plane can do. Add them back one at a time if they earn their memory.
DEBUG=0
OPENSEARCH_ENABLED=0
ENABLE_DRF_SPECTACULAR=0
USE_MINIO=1
USE_STORAGE_PROXY=0
MINIO_ENDPOINT_SSL=0
EMAIL_REPLICAS=0
IFRAMELY_REPLICAS=1
PI_API_REPLICAS=0
PI_BEAT_REPLICAS=0
PI_WORKER_REPLICAS=0
PI_AGENT_WORKER_REPLICAS=0
PI_MIGRATOR_REPLICAS=0
ARGUS_REPLICAS=0
ARGUS_MIGRATOR_REPLICAS=0
RUNNER_REPLICAS=0

# --- Mail ------------------------------------------------------------------
# Plane stores its instance settings in the database, but it seeds any that are
# missing from the environment when its api container starts. Setting them here
# is therefore how the mail wiring is configured - no browser, no session, and no
# god-mode API (which Plane only exposes to its own admin app).
#
# The host is the Mailpit *service name* on the shared network, and the port is
# the one Mailpit listens on inside that network, not the probed host port.
ENABLE_SMTP=1
EMAIL_HOST="${MAILPIT_CONTAINER}"
EMAIL_PORT="${MAIL_INTERNAL_SMTP_PORT}"
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0
EMAIL_FROM="${MAIL_FROM_PLANE}"
EMAIL_HOST_USER=plane
EMAIL_HOST_PASSWORD=plane

# --- API rate limit --------------------------------------------------------
# Plane ships 60 requests/minute per API key. That is low enough that a sync
# which reads the project and then writes a dozen work items is silently
# truncated halfway, and the truncation looks like success (the 429 body carries
# no "error" key). 600/minute keeps a limit but one a local tool fits inside.
API_KEY_RATE_LIMIT=600/minute
