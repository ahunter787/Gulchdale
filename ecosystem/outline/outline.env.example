# Outline environment template.
#
# `install.sh` copies this to ./outline.env (gitignored, mode 0600), fills in
# the generated secrets, and refreshes the values that depend on .env.
# Editing this file does NOT change a running stack: edit outline.env, or
# re-run install.sh for the wiring it owns.
#
# `change-me` is a placeholder that install.sh refuses to leave behind.

NODE_ENV=production
PORT=3000

# The exact origin users reach Outline on. Written by install.sh from
# ECOSYSTEM_SCHEME/ECOSYSTEM_HOST/OUTLINE_HTTP_PORT; it must match the browser
# origin or magic links and cookies break.
URL=http://localhost:8090

# Session and utility signing keys (hex, generated by install.sh).
SECRET_KEY=change-me
UTILS_SECRET=change-me

# --- Database (its own PostgreSQL container) -------------------------------
POSTGRES_USER=outline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=outline
# Written by install.sh from POSTGRES_PASSWORD above.
DATABASE_URL=postgres://outline:change-me@postgres:5432/outline
# The database is on the Docker network with no TLS.
PGSSLMODE=disable

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- Storage ----------------------------------------------------------------
# Local disk on the outline-data volume. No S3/MinIO is involved.
FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000

# --- Runtime ----------------------------------------------------------------
WEB_CONCURRENCY=1
DEFAULT_LANGUAGE=en_US
# Plain HTTP on the LAN: Outline must not redirect to HTTPS or the magic link
# it emails would not resolve.
FORCE_HTTPS=false
# No update check, no telemetry out of a local box.
ENABLE_UPDATES=false
LOG_LEVEL=info
RATE_LIMITER_ENABLED=true

# --- Email (the shared Mailpit sink) ---------------------------------------
# Outline has no password auth at all: sign-in is a magic link or an OAuth
# provider. This is what makes sign-in possible locally.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM_EMAIL=outline@example.local
# Mailpit accepts any credentials, so these stay empty on purpose.
SMTP_USERNAME=
SMTP_PASSWORD=
