# Development ecosystem — runtime configuration (NON-SECRET).
#
# `make env` turns this into .runtime/env, filling in this machine's LAN address
# and a free block of ports (it probes; it never assumes a port is free). It
# never overwrites an existing .runtime/env, so re-running it is safe.
#
# Never put a secret in this file. It is read for names, ports and versions only.
# Secrets live in .runtime/secrets/ (written by the bootstrap) and in the
# services' own generated env files under .runtime/.
#
# Several values below are filled by the scaffold that created this project; if
# you see gulchdale in a generated file, the copy was made by hand.

# --- Identity ---------------------------------------------------------------
# The slug names every container, volume and network this project owns, and it
# is the Plane external source for mirrored work items. Two projects on one
# machine can never collide while their slugs differ.
PROJECT_SLUG=gulchdale
PROJECT_NAME="Gulchdale"

# The address that owns the admin account in both Plane and Outline. Mailpit
# catches everything, so any address works locally; use a real one if this stack
# will be hosted, because password resets and invitations go to it.
ECOSYSTEM_ADMIN_EMAIL="ahunter.cs@gmail.com"

# --- Where everything is reached from ---------------------------------------
# The exact origin a browser uses. It is written into Plane's WEB_URL, Plane's
# CORS_ALLOWED_ORIGINS and Outline's URL, so all three must agree or sign-in and
# magic-link emails break. Set ECOSYSTEM_SCHEME=https when TLS terminates in
# front of these services.
ECOSYSTEM_HOST=@@ECOSYSTEM_HOST@@
ECOSYSTEM_SCHEME=http

# --- Ports ------------------------------------------------------------------
# A free block of eight consecutive ports, chosen by `make env`. Plane publishes
# five (web, HTTPS, and three SMTP intake ports), Outline one, Mailpit two.
PLANE_HTTP_PORT=8100
PLANE_HTTPS_PORT=8101
PLANE_SMTP_PORT_25=8102
PLANE_SMTP_PORT_465=8103
PLANE_SMTP_PORT_587=8104
OUTLINE_HTTP_PORT=8105
MAILPIT_SMTP_PORT=8106
MAILPIT_HTTP_PORT=8107

# --- Names ------------------------------------------------------------------
# Derived from the slug by `make env`, so two projects never share a container,
# volume, network or Plane identifier. Override only when adopting an existing
# stack.
SHARED_NETWORK=@@SHARED_NETWORK@@
PLANE_COMPOSE_PROJECT=@@PLANE_COMPOSE_PROJECT@@
MAIL_COMPOSE_PROJECT=@@MAIL_COMPOSE_PROJECT@@
OUTLINE_COMPOSE_PROJECT=@@OUTLINE_COMPOSE_PROJECT@@
MAILPIT_CONTAINER=@@MAILPIT_CONTAINER@@

# --- Pinned versions --------------------------------------------------------
# Plane's config bundle and its images are tagged with PLANE_VERSION, so an
# upgrade is a one-line change here followed by `make plane-install`.
PLANE_VERSION=v3.3.0
OUTLINE_VERSION=1.10.1
MAILPIT_VERSION=v1.31.4
MAILPIT_MAX_MESSAGES=500

# --- How this project appears inside Plane and Outline ----------------------
# The Plane project identifier: short, upper case, and different from any branch
# name in the project (branch prefixes are what the roadmap sync keys off).
PLANE_PROJECT_IDENTIFIER=@@PLANE_PROJECT_IDENTIFIER@@
# The Outline collection this project publishes into.
OUTLINE_COLLECTION="@@OUTLINE_COLLECTION@@"
# Plane's `external_source` for mirrored work items. Changing it orphans every
# existing work item's identity, so it is fixed at scaffold time.
PLANE_EXTERNAL_SOURCE=@@PLANE_EXTERNAL_SOURCE@@
# Envelope senders for the two services (any address is fine: Mailpit accepts
# everything and never delivers).
MAIL_FROM_PLANE="plane@gulchdale.local"
MAIL_FROM_OUTLINE="outline@gulchdale.local"

# --- What gets published to Outline -----------------------------------------
# Path prefixes in the project checkout that the documentation sync ignores.
# The ecosystem's own documentation is excluded by default: it describes the
# tooling, not the project.
DOCS_EXCLUDE="ecosystem/ .agents/"
